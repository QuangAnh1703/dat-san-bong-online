{
  "name": "sanbong-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST API dat san bong da - Express + PostgreSQL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "migrate": "node src/db/migrate.js migrate",
