    "create-admin": "node src/db/create-admin.js",
    "test": "jest --ci"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0",
    "redis": "^4.6.14"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
