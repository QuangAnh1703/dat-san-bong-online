# ---- Chon MOT trong ba dong duoi ----

# A. App chay ngoai Docker, noi toi CSDL trong container (cong 5433)
DATABASE_URL=postgresql://sanbong:sanbong123@localhost:5433/sanbong

# B. App chay ngoai Docker, noi toi PostgreSQL 18 cai truc tiep tren may (cong 5432)
# DATABASE_URL=postgresql://postgres:MAT_KHAU_CUA_BAN@localhost:5432/sanbong

# C. App chay TRONG docker compose -> host la ten service "db"
# DATABASE_URL=postgresql://sanbong:sanbong123@db:5432/sanbong

PORT=3000
# Thoi gian giu cho (phut) truoc khi don HELD tu huy
HOLD_MINUTES=15

# Frontend duoc phep goi API (nhieu origin thi ngan cach bang dau phay)
CORS_ORIGIN=http://localhost:5173

# Bi mat ky JWT - PHAI doi khi trien khai that, khong dung lai gia tri mau
JWT_ACCESS_SECRET=doi-chuoi-bi-mat-that-dai-o-day
JWT_REFRESH_SECRET=doi-chuoi-bi-mat-khac-o-day
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth (SCRUM-103)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Dia chi backend ma trinh duyet goi toi (SePay return URL, trang thanh toan gia lap)
BACKEND_URL=http://localhost:3000

# SePay API Ngan hang & Webhook (https://my.sepay.vn): khach quet VietQR chuyen vao tai khoan da lien ket SePay,
# SePay goi webhook khi tien ve -> don tu xac nhan.
# SEPAY_BANK_CODE: ten ngan hang theo qr.sepay.vn (VD MBBank, Vietcombank, TPBank, ACB)
# Webhook URL: <BACKEND_URL cong khai>/api/payments/sepay/webhook, kieu xac thuc "API Key" = SEPAY_WEBHOOK_API_KEY
# Chua co SEPAY_WEBHOOK_API_KEY thi QR van hien nhung tien ve khong tu xac nhan don.
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_HOLDER=
SEPAY_WEBHOOK_API_KEY=

# Tro ly dat san (DeepSeek, API tuong thich OpenAI): lay key tai https://platform.deepseek.com/api_keys
# De trong thi /api/chatbot tra loi 503 CHATBOT_NOT_CONFIGURED
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Redis (OTP, gioi han tan suat chatbot). Local: REDIS_HOST/REDIS_PORT; cloud (Upstash): REDIS_URL=rediss://...
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=

# Email gui OTP / bao cao. Chon MOT:
# A. Gmail SMTP (chay local): app password tai https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# B. Brevo HTTP API (Render free chan cong SMTP): key tai https://app.brevo.com/settings/keys/api
#    EMAIL_FROM la email nguoi gui da xac minh trong Brevo (Senders)
# BREVO_API_KEY=
# EMAIL_FROM=
